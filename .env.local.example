# ============================================================
# Pulse8 — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório!
# ============================================================

# ── OBRIGATÓRIAS ── (app não sobe sem estas)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/pulse8_dev"
NEXTAUTH_URL="http://localhost:3000"

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Gere com: openssl rand -base64 32
QR_SECRET=""

# ── OPCIONAIS — Email ──
# ─────────────────────────────────────────────
# Necessário para recuperação de senha
# Obtenha em: https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pulse8 <noreply@pulse8.app>"

# ── OPCIONAIS — Storage de Assets ──
# ─────────────────────────────────────────────
# Para upload de capas de eventos e assets de marketing
# Compatível com AWS S3 ou Cloudflare R2

# AWS S3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="pulse8-assets"

# Cloudflare R2 (adicionar endpoint R2 como AWS_ENDPOINT_URL)
# AWS_ACCESS_KEY_ID=""         # R2 Access Key ID
# AWS_SECRET_ACCESS_KEY=""     # R2 Secret Access Key
# AWS_BUCKET_NAME="pulse8-assets"
# AWS_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
# NEXT_PUBLIC_CDN_DOMAIN="pub-<hash>.r2.dev"

# ── OPCIONAIS — Integrações ──
# ─────────────────────────────────────────────
# Assinatura HMAC para validação de webhooks recebidos do Sympla
SYMPLA_WEBHOOK_SECRET=""

# ── DESENVOLVIMENTO ──
# ─────────────────────────────────────────────
# NODE_ENV=development
