# ==========================================
# PULSE8 — CONFIGURAÇÕES DE AMBIENTE (PRODUÇÃO / DESENVOLVIMENTO)
# ==========================================

# 1. Banco de Dados PostgreSQL (Prisma)
DATABASE_URL="postgresql://pulse8_user:pulse8_secure_password_2026@localhost:5432/pulse8_db?schema=public"

# 2. Autenticação & Sessões (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="pulse8_production_jwt_secret_key_2026_super_secure"

# 3. Segurança Criptográfica de Ingressos (HMAC-SHA256)
HMAC_SECRET="pulse8_qr_hmac_secret_key_production_2026"

# 4. Webhooks Externos (Sympla)
SYMPLA_WEBHOOK_SECRET="pulse8_sympla_webhook_secret_2026"

# 5. Cloud Storage (Cloudflare R2 / AWS S3)
STORAGE_REGION="auto"
R2_ACCOUNT_ID="seu_cloudflare_account_id"
STORAGE_ACCESS_KEY_ID="sua_access_key_id"
STORAGE_SECRET_ACCESS_KEY="sua_secret_access_key"
STORAGE_BUCKET_NAME="pulse8-assets"
STORAGE_PUBLIC_URL="https://assets.pulse8.app"
