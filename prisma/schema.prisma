// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Multi-tenant: Organizações / Produtoras ──
model Organization {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  events       Event[]
  costAccounts CostAccount[]
  suppliers    Supplier[]
  people       People[]
  roles        Role[]
  promoters    Promoter[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

// ── Usuários & Acessos ──
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       String     @default("active")
  avatarUrl    String?    @map("avatar_url")
  twoFactor    Boolean    @default(false) @map("two_factor")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

// ── Eventos ──
model Event {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  name        String
  theme       String?
  description String?
  venue       String?
  city        String?
  state       String?
  capacity    Int       @default(0)
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  status      String    @default("draft") // draft | planning | pre_production | in_sales | closed
  coverUrl    String?   @map("cover_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  areas        Area[]
  tickets      Ticket[]
  costItems    CostItem[]
  revenues     Revenue[]
  assignments  Assignment[]
  campaigns    PromoCampaign[]
  guestLists   GuestList[]
  schedules    Schedule[]
  postQueue    PostQueue[]

  @@index([orgId, status])
  @@map("events")
}

model Area {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  name        String
  capacity    Int      @default(0)
  accessLevel String   @default("geral") @map("access_level")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("areas")
}

model Ticket {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  areaId    String   @map("area_id")
  lot       String   @default("1º Lote")
  price     Float
  qtyTotal  Int      @default(0) @map("qty_total")
  qtySold   Int      @default(0) @map("qty_sold")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

// ── Financeiro & Custos ──
model CostAccount {
  id        String        @id @default(uuid())
  orgId     String        @map("org_id")
  name      String
  parentId  String?       @map("parent_id")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       CostAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     CostAccount[] @relation("AccountHierarchy")
  costItems    CostItem[]

  @@map("cost_accounts")
}

model CostItem {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  accountId     String?   @map("account_id")
  supplierId    String?   @map("supplier_id")
  title         String
  qty           Float     @default(1)
  unitCost      Float     @default(0) @map("unit_cost")
  totalCost     Float     @default(0) @map("total_cost")
  dueDate       DateTime? @map("due_date")
  paidAt        DateTime? @map("paid_at")
  status        String    @default("planned") // planned | pending | approved | paid | overdue
  attachmentUrl String?   @map("attachment_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account  CostAccount? @relation(fields: [accountId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])

  @@index([eventId, status])
  @@map("cost_items")
}

model Revenue {
  id         String    @id @default(uuid())
  eventId    String    @map("event_id")
  source     String    // Sympla | Promoters | Bar | Patrocinio
  amount     Float
  receivedAt DateTime? @map("received_at")
  reference  String?
  createdAt  DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("revenues")
}

// ── Fornecedores & Equipe ──
model Supplier {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  cnpjCpf   String?  @map("cnpj_cpf")
  contact   String?
  email     String?
  phone     String?
  pix       String?
  category  String?
  rating    Float?   @default(5.0)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  costItems    CostItem[]

  @@map("suppliers")
}

model People {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  fullName  String   @map("full_name")
  doc       String?
  email     String?
  phone     String?
  address   String?
  pix       String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments  Assignment[]
  promoters    Promoter[]

  @@map("people")
}

model Role {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  department  String?
  color       String?  @default("bg-brand-500")
  accessLevel String   @default("staff") @map("access_level")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments  Assignment[]

  @@map("roles")
}

model Assignment {
  id         String    @id @default(uuid())
  eventId    String    @map("event_id")
  personId   String    @map("person_id")
  roleId     String    @map("role_id")
  shiftStart DateTime? @map("shift_start")
  shiftEnd   DateTime? @map("shift_end")
  payRate    Float?    @map("pay_rate")
  payType    String?   @default("daily") @map("pay_type") // daily | monthly | hourly
  status     String    @default("scheduled")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person People @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@map("assignments")
}

// ── Promoters & Vendas ──
model Promoter {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  personId  String   @map("person_id")
  team      String?
  level     String?  @default("junior")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  person       People       @relation(fields: [personId], references: [id], onDelete: Cascade)
  promoLinks   PromoLink[]
  promosales   PromoSale[]

  @@map("promoters")
}

model PromoCampaign {
  id              String    @id @default(uuid())
  eventId         String    @map("event_id")
  name            String
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  commissionType  String    @default("percent") @map("commission_type") // percent | fixed
  commissionValue Float     @map("commission_value")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoLinks PromoLink[]
  promoSales PromoSale[]

  @@map("promo_campaigns")
}

model PromoLink {
  id         String  @id @default(uuid())
  campaignId String  @map("campaign_id")
  promoterId String  @map("promoter_id")
  code       String  @unique
  url        String
  utmSource  String? @default("promoter") @map("utm_source")
  utmMedium  String? @map("utm_medium")

  campaign PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promoter Promoter      @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("promo_links")
}

model PromoSale {
  id            String   @id @default(uuid())
  campaignId    String   @map("campaign_id")
  promoterId    String   @map("promoter_id")
  code          String
  buyerName     String?  @map("buyer_name")
  buyerEmail    String?  @map("buyer_email")
  qty           Int      @default(1)
  amount        Float
  channel       String   @default("sympla") // sympla | direct
  soldAt        DateTime @default(now()) @map("sold_at")
  ticketingTxId String?  @map("ticketing_tx_id")

  campaign PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promoter Promoter      @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([code, promoterId])
  @@map("promo_sales")
}

// ── Convidados & Check-in ──
model GuestList {
  id      String  @id @default(uuid())
  eventId String  @map("event_id")
  name    String  // VIP | Imprensa | Staff | Promoters
  type    String?

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@map("guestlists")
}

model Guest {
  id          String    @id @default(uuid())
  guestlistId String    @map("guestlist_id")
  fullName    String    @map("full_name")
  email       String?
  phone       String?
  source      String?   @default("manual")
  promoterId  String?   @map("promoter_id")
  qrCode      String    @unique @map("qr_code")
  status      String    @default("issued") // issued | confirmed | checked_in | blocked
  checkedInAt DateTime? @map("checked_in_at")
  notes       String?

  guestList GuestList @relation(fields: [guestlistId], references: [id], onDelete: Cascade)

  @@index([qrCode, status])
  @@map("guests")
}

// ── Operacional & Marketing ──
model Schedule {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  type        String    @default("run") // setup | run | teardown
  title       String
  description String?
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  ownerName   String?   @map("owner_name")
  status      String    @default("pending")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model PostQueue {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  platform    String    @default("instagram")
  title       String
  copy        String?
  assetUrl    String?   @map("asset_url")
  scheduledAt DateTime? @map("scheduled_at")
  status      String    @default("draft") // draft | scheduled | published | failed
  postUrl     String?   @map("post_url")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("post_queue")
}

// ── Auditoria & Logs ──
model AuditLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
